# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller / Build outputs (do not commit binaries/build caches to repo)
build/
dist/
*.spec.bak
*.zip

# Microsoft Office temporary files
~$*
*.tmp

# User output / generated reports
07. OUTPUT FILE/INDIVIDUAL/*
!07. OUTPUT FILE/INDIVIDUAL/.gitkeep

# Ignore raw photos in example workspace (keep folder structure only)
PO FOLDER EXAMPLE/03. RAW MATERIAL/**/*.jpg
PO FOLDER EXAMPLE/03. RAW MATERIAL/**/*.JPG
PO FOLDER EXAMPLE/03. RAW MATERIAL/**/*.jpeg
PO FOLDER EXAMPLE/03. RAW MATERIAL/**/*.png
PO FOLDER EXAMPLE/03. RAW MATERIAL/**/*.PNG

# IDEs & Editor files
.vscode/
.idea/
*.swp
*.swo

# Environment & logs
*.log
.env
venv/
.venv/
